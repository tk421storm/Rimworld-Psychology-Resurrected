<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <JobDef>
    <defName>Abuse</defName>
    <driverClass>Psychology.JobDriver_Abuse</driverClass>
    <reportString>verbally abusing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  
  <JobDef>
    <defName>MakeAdvance</defName>
    <driverClass>Psychology.JobDriver_MakeAdvance</driverClass>
    <reportString>flirting with TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  
  <JobDef>
    <defName>BreakHunt</defName>
    <driverClass>Psychology.JobDriver_BreakHunt</driverClass>
    <reportString>hunting TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <suspendable>false</suspendable>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- Hookups -->
  <JobDef>
    <defName>DoLovinCasual</defName>
    <driverClass>Psychology.JobDriver_DoLovinCasual</driverClass>
    <reportString>lovin'.</reportString>
    <joySkill>Social</joySkill>
    <joyXpPerTick>0.004</joyXpPerTick>
    <joyKind>Lewd</joyKind>
  </JobDef>

  <!-- Dates -->
  <JobDef>
    <defName>DateDance</defName>
    <driverClass>Psychology.JobDriver_DateDance</driverClass>
    <reportString>dancing with TargetA.</reportString>
    <joyKind>Social</joyKind>
  </JobDef>

  <JobDef>
    <defName>DateWorkwatch</defName>
    <driverClass>Psychology.JobDriver_DateWorkwatch</driverClass>
    <reportString>watching TargetA work.</reportString>
    <joyKind>Social</joyKind>
    <joyGainRate>0.4</joyGainRate>
  </JobDef>

  <!-- Hugs -->
  <JobDef>
    <defName>Hug</defName>
    <driverClass>Psychology.JobDriver_Hug</driverClass>
    <reportString>hugging TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>
  
</Defs>